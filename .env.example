# Copy this file to .env. Set the required values before starting Docker Compose.
POSTGRES_DB=lecturelens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Format: postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AI_PROVIDER=mock
AI_API_KEY=

VALIDATION_THRESHOLD=75.0
MAX_RETRY_COUNT=3

MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

VITE_API_BASE_URL=/api
